{
  "manifest_version": 3,
  "name": "YouTube Audio Download",
  "version": "1.1.0",
  "description": "Downloads the best-quality audio of the current YouTube video using yt-dlp.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YouTube Audio Download (Alt+Shift+A)",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the download menu"
    }
  }
}
