{
  "manifest_version": 3,
  "name": "Video & Audio Download",
  "version": "2.0.0",
  "description": "Downloads the video or audio of the current page (YouTube and most other sites) using yt-dlp.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Video & Audio Download (Alt+Shift+A)",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Open the download menu"
    }
  }
}
